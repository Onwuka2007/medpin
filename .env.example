# ==========================================
# MedPin Frontend Environment Variables
# ==========================================

# Groq API Key (required for AI Drug Search and Medical Assistant)
# Get your free key at: https://console.groq.com
VITE_GROQ_API_KEY=your_groq_api_key_here

# NAFDAC Greenbook API URL (defaults to production http://localhost:8000 for local)
VITE_NAFDAC_API_URL

# MedPin Backend API URL (defaults to Express backend at http://localhost:8080)
VITE_API_BASE_URL=http://localhost:8080
