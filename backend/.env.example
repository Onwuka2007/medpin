# ==========================================
# MedPin Backend Environment Variables
# ==========================================

# Server Port
PORT=8080

# MongoDB Connection String (Atlas or Local MongoDB)
MONGO_URI=...

# JWT Authentication Secret & Expiration
# Generate a secure key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d
